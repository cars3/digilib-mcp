# Copy this file to .env and set what you want. .env is gitignored.
# Everything here is OPTIONAL: digilib runs fully keyless with no .env at all.
# Place .env at the repo root or inside digilib_mcp/ - the server auto-loads
# it on startup (see digilib_mcp/config.py), checking digilib_mcp/ first.
# Real environment variables always win over the file.

# Your email, shared with OpenAlex for the polite pool (better rate limits).
# Unset by default.
DIGILIB_OPENALEX_EMAIL=

# Optional Google Books API key for a more reliable quota.
# Get one: https://console.cloud.google.com -> enable the Books API ->
# Credentials -> API key. Without it, books still come from Open Library.
DIGILIB_GOOGLE_BOOKS_API_KEY=

# Transport: "stdio" (default; Claude Desktop/Code and most clients) or
# "streamable-http" (HTTP gateway for remote agents / hosting).
DIGILIB_TRANSPORT=stdio

# --- streamable-http only ---
# Shared secret for the HTTP gateway: when set, every request must carry
# `Authorization: Bearer <token>`. Set this when hosting publicly; without
# it the endpoint is open and anyone with the URL can call the tools.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
DIGILIB_GATEWAY_TOKEN=

# Comma-separated Host allow-list for the HTTP gateway, e.g.
# "example.com,*.example.com". Leave unset behind a reverse proxy.
DIGILIB_ALLOWED_HOSTS=
